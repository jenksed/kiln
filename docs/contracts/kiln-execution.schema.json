{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiln:schema:execution:v0",
  "title": "Kiln Execution Domain Contracts v0",
  "description": "Protocol-neutral contracts for Kiln agents, workers, model invocations, capabilities, tools, commands, terminals, approval, attention, and interruption.",
  "oneOf": [
    { "$ref": "#/$defs/agentDefinition" },
    { "$ref": "#/$defs/workerLease" },
    { "$ref": "#/$defs/modelInvocation" },
    { "$ref": "#/$defs/capability" },
    { "$ref": "#/$defs/capabilityGrant" },
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/resource" },
    { "$ref": "#/$defs/toolCall" },
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/terminal" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/attentionRequest" },
    { "$ref": "#/$defs/interruption" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Opaque Kiln-generated UUIDv7 identifier."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._+-]*:[A-Fa-f0-9]+$"
    },
    "entityMeta": {
      "type": "object",
      "required": ["schema_version", "created_at"],
      "properties": {
        "schema_version": { "const": "kiln.domain/v0" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "last_event_sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "resourceScope": {
      "type": "object",
      "required": ["resource_kind", "resource_ref"],
      "properties": {
        "resource_kind": {
          "enum": ["workspace", "project", "repository", "path", "environment", "process", "network_host", "secret", "model", "tool", "terminal", "artifact", "external_system", "other"]
        },
        "resource_ref": { "type": "string", "minLength": 1 },
        "constraints": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "agentDefinition": {
      "type": "object",
      "required": ["agent_definition_id", "name", "version", "digest", "instruction_artifact_ids", "skill_bindings", "model_policy", "status", "meta"],
      "properties": {
        "agent_definition_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "instruction_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "skill_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill_id", "version_digest"],
            "properties": {
              "skill_id": { "$ref": "#/$defs/id" },
              "version_digest": { "$ref": "#/$defs/digest" }
            },
            "additionalProperties": false
          }
        },
        "model_policy": {
          "type": "object",
          "required": ["selection_mode"],
          "properties": {
            "selection_mode": { "enum": ["fixed", "capability_match", "user_selected", "deterministic_only"] },
            "allowed_model_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "status": { "enum": ["draft", "accepted", "deprecated", "superseded"] },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "workerLease": {
      "type": "object",
      "required": ["worker_instance_id", "run_id", "kind", "status", "leased_at", "lease_expires_at"],
      "properties": {
        "worker_instance_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["model", "deterministic", "command", "human_bridge", "adapter", "other"] },
        "status": { "enum": ["starting", "leased", "active", "draining", "stopped", "crashed", "expired"] },
        "leased_at": { "$ref": "#/$defs/timestamp" },
        "lease_expires_at": { "$ref": "#/$defs/timestamp" },
        "last_heartbeat_at": { "$ref": "#/$defs/timestamp" },
        "termination_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "modelInvocation": {
      "type": "object",
      "required": ["model_invocation_id", "run_id", "context_manifest_id", "model_ref", "provider_adapter_ref", "request_digest", "status", "usage", "meta"],
      "properties": {
        "model_invocation_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "context_manifest_id": { "$ref": "#/$defs/id" },
        "agent_definition_id": { "$ref": "#/$defs/id" },
        "model_ref": { "type": "string", "minLength": 1 },
        "provider_adapter_ref": { "type": "string", "minLength": 1 },
        "request_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["created", "queued", "streaming", "completed", "failed", "canceled", "orphaned"] },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cost_microunits": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "finish_reason": { "type": ["string", "null"] },
        "output_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["capability_key", "version", "scope_schema", "status"],
      "properties": {
        "capability_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "scope_schema": { "type": "object", "additionalProperties": true },
        "status": { "enum": ["defined", "available", "unavailable", "deprecated", "superseded"] }
      },
      "additionalProperties": false
    },
    "capabilityGrant": {
      "type": "object",
      "required": ["capability_grant_id", "run_id", "capability_key", "capability_version", "resource_scope", "decision", "issuer", "issued_at", "policy_snapshot", "limits"],
      "properties": {
        "capability_grant_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "capability_key": { "type": "string", "minLength": 3 },
        "capability_version": { "type": "string", "minLength": 1 },
        "resource_scope": { "$ref": "#/$defs/resourceScope" },
        "decision": { "enum": ["granted", "denied"] },
        "issuer": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["user", "policy", "administrator"] },
            "id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "approval_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "policy_snapshot": {
          "type": "object",
          "required": ["repository_trust_policy_id", "privacy_policy_id"],
          "properties": {
            "repository_trust_policy_id": { "$ref": "#/$defs/id" },
            "privacy_policy_id": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "limits": { "type": "object", "additionalProperties": true },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "name", "version", "digest", "input_schema", "output_schema", "required_capability_keys", "status", "meta"],
      "properties": {
        "skill_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "input_schema": { "type": "object", "additionalProperties": true },
        "output_schema": { "type": "object", "additionalProperties": true },
        "instruction_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "required_capability_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "status": { "enum": ["draft", "accepted", "available", "deprecated", "superseded"] },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["resource_id", "kind", "owner_scope", "trust_class", "sensitivity", "availability", "meta"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["repository", "path", "environment", "model", "tool", "secret", "network_host", "terminal", "artifact", "external_system", "other"] },
        "owner_scope": { "$ref": "#/$defs/resourceScope" },
        "trust_class": { "enum": ["active", "reference_only", "untrusted_external", "system"] },
        "sensitivity": { "enum": ["public", "internal", "confidential", "secret", "restricted"] },
        "availability": { "enum": ["available", "unavailable", "removed"] },
        "observed_version": { "type": ["string", "null"] },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "required": ["tool_call_id", "run_id", "tool_key", "tool_version", "arguments", "required_capability_keys", "grant_ids", "status", "meta"],
      "properties": {
        "tool_call_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "model_invocation_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "tool_key": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object", "additionalProperties": true },
        "required_capability_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "grant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "status": { "enum": ["requested", "authorized", "denied", "queued", "running", "completed", "failed", "canceled", "orphaned"] },
        "result_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "error": { "type": ["string", "null"] },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "environmentReference": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "enum": ["literal_redacted", "project_config", "secret_ref", "environment_default"] },
        "value_or_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["command_id", "tool_call_id", "run_id", "environment_id", "executable", "argv", "working_directory_ref", "environment", "shell_mode", "status", "meta"],
      "properties": {
        "command_id": { "$ref": "#/$defs/id" },
        "tool_call_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "environment_id": { "$ref": "#/$defs/id" },
        "executable": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "working_directory_ref": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentReference" }
        },
        "shell_mode": { "enum": ["none", "explicit_shell"] },
        "timeout_ms": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["created", "authorized", "starting", "running", "exited", "timed_out", "canceled", "killed", "orphaned", "failed_to_start"] },
        "exit_code": { "type": ["integer", "null"] },
        "termination_signal": { "type": ["string", "null"] },
        "stdout_artifact_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "stderr_artifact_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "required": ["terminal_id", "command_id", "run_id", "status", "dimensions", "input_retention", "meta"],
      "properties": {
        "terminal_id": { "$ref": "#/$defs/id" },
        "command_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["created", "opening", "open", "detached", "closing", "closed", "failed", "orphaned"] },
        "dimensions": {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "integer", "minimum": 1 },
            "rows": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "input_retention": { "enum": ["none", "digest_only", "redacted", "full_by_policy"] },
        "transcript_artifact_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "meta": { "$ref": "#/$defs/entityMeta" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approval_id", "request_scope", "actor_id", "decision", "reason", "policy_version", "decided_at"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/id" },
        "request_scope": { "$ref": "#/$defs/resourceScope" },
        "actor_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "denied"] },
        "reason": { "type": "string" },
        "policy_version": { "type": "string", "minLength": 1 },
        "decided_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "attentionRequest": {
      "type": "object",
      "required": ["attention_request_id", "session_id", "source_run_id", "type", "urgency", "summary", "response_schema", "blocking", "status", "created_at"],
      "properties": {
        "attention_request_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "source_run_id": { "$ref": "#/$defs/id" },
        "parent_run_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "type": { "enum": ["question", "approval", "permission", "conflict", "failure", "decision", "priority"] },
        "urgency": { "enum": ["blocking", "high", "normal", "low"] },
        "summary": { "type": "string", "minLength": 1 },
        "response_schema": { "type": "object", "additionalProperties": true },
        "blocking": { "type": "boolean" },
        "status": { "enum": ["open", "acknowledged", "resolved", "deferred", "expired", "withdrawn"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "resolved_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "resolution_artifact_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "interruption": {
      "type": "object",
      "required": ["interruption_id", "session_id", "target_kind", "target_id", "action", "actor_id", "reason", "status", "requested_at"],
      "properties": {
        "interruption_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "target_kind": { "enum": ["run", "model_invocation", "tool_call", "command", "terminal"] },
        "target_id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["pause", "cancel", "detach", "stop_input", "terminate"] },
        "actor_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "status": { "enum": ["requested", "acknowledged", "applied", "failed", "superseded"] },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "applied_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    }
  }
}
